{
	"name": "api-emergency-tool",
	"version": "0.0.1",
	"description": "",
	"author": "Browserbite",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"check-branch-name": "chmod 755 ./.githooks/check_branch_name.sh && sh ./.githooks/check_branch_name.sh",
		"prebuild": "rimraf dist",
		"build": "nest build",
		"build:start": "npm run db:update && npm run db:update:constants && node dist/main",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "DEBUG=engine,socket.io* node dist/main",
		"start:prod:db": "npm run db:update && DEBUG=engine,socket.io* node --max-old-space-size=6144 --report-uncaught-exception --report-on-signal --report-on-fatalerror dist/main",
		"start:prod:db:dev": "npm run db:update && node --max-old-space-size=2048 dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest --watchAll --maxWorkers=1 --rootDir=./",
		"test:watch": "jest --forceExit --detectOpenHandles --watchAll --config ./test/jest-e2e.json --rootDir=./ --runInBand --maxConcurrency=1",
		"test:cov": "jest --coverage",
		"test:debugging": "jest --config ./test/jest-e2e.json --rootDir=./ --debug --maxWorkers=1 --detectOpenHandles",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --rootDir=./ --config ./test/jest-e2e.json --maxWorkers=1",
		"test:e2e": "jest --config ./test/jest-e2e.json --rootDir=./  --runInBand --maxConcurrency=1",
		"prepare": "husky",
		"pre-commit": "npm run check-branch-name && lint-staged",
		"seed:generate": "sequelize-cli seed:generate --name $npm_config_name",
		"migration:generate": "sequelize-cli migration:generate --name $npm_config_name",
		"db:seed": "sequelize-cli db:seed:all",
		"db:migrate": "sequelize-cli db:migrate",
		"db:update": "npm run db:migrate && npm run db:seed",
		"migration:undo": "sequelize-cli db:migrate:undo",
		"db:bets:seed:undo": "sequelize-cli db:seed:undo:all",
		"db:operator:migrate:undo": "sequelize-cli db:migrate:undo:all",
		"db:revert": "npm run db:seed:undo && npm run db:migrate:undo ",
		"db:update:constants": "npm run db:seed:constants",
		"db:seed:constants": "ts-node -r tsconfig-paths/register src/seed.ts"
	},
	"lint-staged": {
		"*.ts": "eslint"
	},
